<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Catppuccin Mocha theme for Xcode.

  Mirrors the editor preferences used in VS Code and Zed in this repo:
  Catppuccin palette + Hack Nerd Font Mono at size 15.
  Xcode has no single JSON settings file, so font/color live in this
  .xccolortheme while behaviour toggles (Vim mode, line numbers, page
  guide at 80, etc.) are applied via `just setup-xcode`.

  Palette: https://github.com/catppuccin/catppuccin (Mocha)
-->
